# The BigWigs packager revision every build and release uses. It is pinned
# to an exact commit (the v2 tag as of 2026-09-28) so an upstream change
# cannot alter what runs. Update deliberately; builds and releases share it.
PACKAGER_COMMIT="e50a250f8705041e40f2fa1ddcb280a686d65aa0"
# SHA-256 of release.sh at that commit. tools/fetch-packager.sh refuses to
# use a download that doesn't match, so the script that receives the
# CurseForge token is exactly the one reviewed. Update it with the commit.
PACKAGER_SHA256="59b15a8d851b09e6d0fdec702aec91331b9b49d84dbe778da6c621b48f268703"
